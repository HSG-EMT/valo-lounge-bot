# Database (MySQL) — must be the exact SAME database as valo-lounge-server's
# DATABASE_URL. Migrations are owned by valo-lounge-server; this project only
# reads/writes data. Using a real (network-reachable) MySQL here — instead of
# a local file — is what lets this bot be deployed on a separate host (e.g. a
# Discord-bot hosting service) from the website server.
DATABASE_URL="mysql://user:password@localhost:3306/valo_lounge"

# Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID to register slash commands to during development (instant update).
DISCORD_GUILD_ID=

# Riot Games Developer Portal (https://developer.riotgames.com) — used by /전적.
# Personal dev keys ("RGAPI-...") expire every 24h and must be refreshed manually.
RIOT_API_KEY=

# Discord channel synced into the website's community/notice page. Requires
# the "MESSAGE CONTENT INTENT" privileged intent enabled in the Developer
# Portal (Bot tab), same place as Server Members Intent.
ANNOUNCEMENT_CHANNEL_ID=
